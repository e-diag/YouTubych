# ==========================================
# YouTubych Bot Configuration
# ==========================================

# Telegram Bot Token from @BotFather (e.g. 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Google Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model to use (e.g. gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Optional: Custom Gemini API Base URL (e.g. via Cloudflare Worker reverse proxy)
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Optional: Outbound proxy for Gemini API (e.g. http://ip:port or socks5://ip:port)
# PROXY_URL=http://user:pass@proxy-ip:port

# Telegram Group Chat ID where YouTubych is allowed to operate (e.g. -1001234567890)
# Bot will automatically leave any other unauthorized groups.
ALLOWED_CHAT_ID=-1001234567890

# Owner's Telegram User ID (e.g. 123456789)
# In direct messages (PM), the bot will ONLY respond to this user for settings and stats.
OWNER_TG_ID=123456789

# Silence duration before YouTubych generates an icebreaker topic (default: 6h)
SILENCE_DURATION=6h

# Rate limit cooldowns to prevent spam and abuse
USER_COOLDOWN=15s
GROUP_COOLDOWN=5s

# SQLite database file path (created automatically)
DATABASE_PATH=youtubych.db
